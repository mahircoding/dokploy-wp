#############################
# Domain
#############################

# Optional host port for local Docker Compose testing.
# Leave empty for Dokploy deployments so the platform can manage routing.
APP_PORT=

DOMAIN=example.com

# If behind a reverse proxy (e.g. Dokploy), set this to the public URL
# WordPress should use. Use https:// for production and match the domain
# configured in Dokploy exactly.
WP_URL=https://example.com

#############################
# WordPress
#############################

WP_VERSION=latest

PHP_VERSION=8.4

WP_TITLE=My Website

WP_USER=admin

WP_PASSWORD=ChangeThisPassword

WP_EMAIL=admin@example.com

#############################
# Database
#############################

DB_NAME=wordpress

DB_USER=wordpress

DB_PASSWORD=StrongPassword123

DB_ROOT_PASSWORD=RootPassword123

# Service name of the database container (internal network only).
DB_HOST=mariadb

#############################
# Redis
#############################

REDIS_PASSWORD=redispassword

# Service name of the redis container (internal network only).
REDIS_HOST=redis

#############################
# Timezone
#############################

TZ=Asia/Jakarta